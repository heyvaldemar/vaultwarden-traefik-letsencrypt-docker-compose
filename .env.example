# Vaultwarden + Traefik + Let's Encrypt — Environment Variables
# Copy this file to `.env` and fill in each value before `docker compose up`.
# `.env` is gitignored — never commit real credential values.
#
# Image versions are NOT set here. The tested tag + sha256 digest lives in
# the compose file's `x-images` block, so `git pull` delivers the versions
# this repository has tested. To pin differently, uncomment:
# VAULTWARDEN_IMAGE_TAG=vaultwarden/server:1.37.2@sha256:…
# TRAEFIK_IMAGE_TAG=traefik:3.7@sha256:…

# Traefik Variables
# Log level: DEBUG, INFO, WARN, ERROR. Default: WARN.
# TRAEFIK_LOG_LEVEL=WARN

# The email address used by Let's Encrypt for renewal notices.
# REQUIRED.
TRAEFIK_ACME_EMAIL=admin@example.com

# The hostname of the Traefik dashboard (DNS must point at this server).
# REQUIRED.
TRAEFIK_HOSTNAME=traefik.vaultwarden.example.com

# Basic auth for the Traefik dashboard.
# REQUIRED. Generate your own (replace the username and password):
#     htpasswd -nB traefikadmin
# or with Docker, no local htpasswd needed:
#     docker run --rm httpd:2.4 htpasswd -nbB traefikadmin your-password
# Escape every `$` in the hash as `$$` when pasting into this file.
TRAEFIK_BASIC_AUTH=

# Vaultwarden Variables
# The hostname the vault is served on (DNS must point at this server).
# REQUIRED.
VAULTWARDEN_HOSTNAME=vaultwarden.example.com

# Whether new accounts can register. Leave true for the first start,
# register your own accounts, then set false and recreate the stack —
# a password manager should not accept strangers. Default: true.
# VAULTWARDEN_SIGNUPS_ALLOWED=true

# Resource limits (defaults shown). Each service carries memory/CPU limits and
# reservations as compose-level defaults; override any of them here and the
# override survives every git pull. Sizing is per host: raise a limit if a
# service is OOM-killed (docker inspect shows OOMKilled=true).
# VAULTWARDEN_MEMORY_LIMIT=512m
# VAULTWARDEN_CPU_LIMIT=1.0
# VAULTWARDEN_MEMORY_RESERVATION=64m
# VAULTWARDEN_CPU_RESERVATION=0.25
# TRAEFIK_MEMORY_LIMIT=256m
# TRAEFIK_CPU_LIMIT=0.5
# TRAEFIK_MEMORY_RESERVATION=64m
# TRAEFIK_CPU_RESERVATION=0.1
